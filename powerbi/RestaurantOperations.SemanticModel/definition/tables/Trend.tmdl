table Trend
	column month
		dataType: dateTime
		sourceColumn: month
	column inspections
		dataType: int64
		sourceColumn: inspections
	column complaints
		dataType: int64
		sourceColumn: complaints
	column critical_violations
		dataType: int64
		sourceColumn: critical_violations

	partition Trend = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "\monthly_trend.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Types = Table.TransformColumnTypes(Headers, {{"month", type date}, {"inspections", Int64.Type}, {"complaints", Int64.Type}, {"critical_violations", Int64.Type}})
			in
				Types
