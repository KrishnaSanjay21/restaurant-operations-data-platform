table Risk
	column restaurant_name
		dataType: string
		sourceColumn: restaurant_name
	column borough
		dataType: string
		sourceColumn: borough
	column cuisine_description
		dataType: string
		sourceColumn: cuisine_description
	column risk_score
		dataType: double
		sourceColumn: risk_score
	column risk_tier
		dataType: string
		sourceColumn: risk_tier
	column critical_violation_count
		dataType: int64
		sourceColumn: critical_violation_count
	column matched_complaint_count
		dataType: int64
		sourceColumn: matched_complaint_count

	partition Risk = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "\priority_restaurants.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Types = Table.TransformColumnTypes(Headers, {{"restaurant_name", type text}, {"borough", type text}, {"cuisine_description", type text}, {"risk_score", type number}, {"risk_tier", type text}, {"critical_violation_count", Int64.Type}, {"matched_complaint_count", Int64.Type}})
			in
				Types
